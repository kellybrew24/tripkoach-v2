# TripKoach v2 API — environment. Copy to .env for local, or load from the secret store on the box.
# NEVER commit real secrets. On the dev box these come from secret `tripkoach-v2-dev.env` (TRI-862).

# --- Local dev / smoke (no external Postgres needed) ---
# Leave DATABASE_URL unset → the service uses PGlite (in-process Postgres, WASM) and auto-migrates+seeds.
# DB_DRIVER=pglite
# PGLITE_DATA=memory://            # or a path like ./pgdata to persist locally

# --- Real Postgres (dev box / prod) ---
# Set DATABASE_URL → the service uses node-postgres. Get it from the secret store, never a comment.
# DATABASE_URL=postgresql://tripkoach_dev:***@127.0.0.1:5432/tripkoach_dev
# DB_DRIVER=pg

# Bind (DevOps proxies /api/* → 127.0.0.1:3020 verbatim on the dev box)
PORT=3020
HOST=127.0.0.1
API_PREFIX=/api/v1
NODE_ENV=development

# Run migrations on boot? Defaults: true for pglite, false for pg (DevOps/deploy runs `npm run migrate`).
# AUTO_MIGRATE=false

# --- Phase 2 (TRI-866): booking holds + Paystack payments ---
# Online seat-hold window in minutes (booking.reservation_expires_at = now() + this). Default 30.
# RESERVATION_HOLD_MINUTES=30

# Paystack — TEST keys only in this slice. NEVER commit real keys; DevOps injects them into the
# systemd service env from secret `tripkoach-paystack.env` (keys prefixed TRIPKOACH_PAYSTACK_*).
# Both the neutral names below and the TRIPKOACH_PAYSTACK_* names are accepted.
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Webhook HMAC key. If unset, the secret key is used (Paystack signs webhooks with the secret key).
# PAYSTACK_WEBHOOK_SECRET=
# Paystack API base (override only for tests/mocks).
# PAYSTACK_BASE_URL=https://api.paystack.co

# USD→GHS CHARGE rate. Prices are USD; Paystack is charged in GHS pesewas. Precedence (env wins):
#   PAYSTACK_USD_TO_GHS_RATE  →  settings.usd_to_ghs_charge_rate  →  settings.usd_to_ghs_display_rate (15.6)
# In PROD leave this UNSET so the automated daily FX cron (Phase 4, below) drives the charge rate.
# Set it ONLY as an ops kill-switch to pin the rate (bypasses the fetch; recorded as 'override').
# PAYSTACK_USD_TO_GHS_RATE=15.6

# --- Phase 4 (TRI-873): automated daily USD→GHS FX ---
# The `npm run fx-refresh` cron fetches the mid-market rate, applies FX_BUFFER_PCT, and writes the
# effective rate into settings.usd_to_ghs_charge_rate (drives charges via the precedence above).
# Provider is env-swappable; default is exchangerate-api.com's free open endpoint (GHS supported, no key).
# FX_PROVIDER_NAME=open.er-api.com
# FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
# FX_TARGET_CURRENCY=GHS
# FX_BUFFER_PCT=1.75            # % on top of mid-market → effective charge rate
# FX_MAX_DEVIATION_PCT=5        # reject a fetch deviating more than this % from last-known-good
# FX_TIMEOUT_MS=10000
# Install as a daily cron @ 00:00 Africa/Accra (UTC±0):  0 0 * * *  cd apps/api && npm run fx-refresh

# --- Email / notification transport (P0, TRI-880) ---
# Shared sendEmail() lib dispatches via Resend. Reuse the legacy stack's Resend account/domain
# (send.tripkoach.com — DKIM/SPF already live). Secrets come from the secret store, never code.
# When RESEND_API_KEY is UNSET (or EMAIL_DRY_RUN=true) the transport is DISABLED: emails still render
# and log a 'skipped' row in email_message, but nothing is dispatched — safe for dev/staging.
# Both the neutral names below and the TRIPKOACH_* names DevOps injects are accepted.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=TripKoach <bookings@send.tripkoach.com>
# EMAIL_REPLY_TO=hello@tripkoach.com
# EMAIL_PROVIDER_NAME=resend
# EMAIL_API_BASE=https://api.resend.com     # override only for tests/mocks
# EMAIL_DRY_RUN=false                        # true = render + log 'skipped', never dispatch (ops safety valve)
# EMAIL_TIMEOUT_MS=10000

# --- Booking-lifecycle notifications + departure-reminder cron (P5.2, TRI-889) ---
# Emails ride the transport above; when it's disabled every send logs 'skipped' (inert dev/staging).
# WEB_BASE_URL builds the "view/manage booking" links in emails (no trailing slash).
# WEB_BASE_URL=https://app.tripkoach.com
# REMINDER_DAYS_BEFORE=3                      # departure-reminder lead time (days out) for `npm run send-reminders`
# One-shot live deliverability check (after keys are wired):  npm run send-email -- you@example.com

# --- Admin realm (Phase 3, TRI-869) ---
# ADMIN_PREFIX=/api/admin
# ADMIN_COOKIE_NAME=tk_admin_session
# ADMIN_SESSION_IDLE_MINUTES=30
# COOKIE_SECURE defaults to true (the dev box + prod serve the admin SPA over HTTPS via Caddy).
# Set false ONLY for local plain-HTTP testing so the browser will store the session cookie.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
#
# Bootstrap the first admin (npm run admin-seed) — password comes from here / the secret store, never code:
# STAFF_EMAIL=you@tripkoach.com
# STAFF_PASSWORD=change-me
# STAFF_NAME=Your Name
# STAFF_ROLE=admin            # admin | operator | viewer

# --- Consumer accounts & auth (P1, TRI-881) ---
# The customer-facing auth spine (signup/login/session, /me profile + notification prefs, password reset,
# link guest bookings). Sessions are subject_type='user' in the shared `session` table; the cookie reuses
# the COOKIE_SECURE/COOKIE_SAMESITE posture above. Password-reset emails go through the P0 transport, so
# EMAIL_FROM (above) must be set for reset mail to render/log (dispatch still gated by RESEND_API_KEY).
# USER_COOKIE_NAME=tk_user_session
# USER_SESSION_IDLE_MINUTES=20160        # sliding idle window; default 14 days
# PASSWORD_RESET_TTL_MINUTES=60          # single-use reset-token lifetime
# APP_BASE_URL=https://app.tripkoach.com # public app origin used to build the reset link in the email

# --- Admin media upload → CDN publish (TRI-918) ---
# Admin image upload → validation (magic-byte sniff + size/type allow-list) → publish to Cloudflare R2
# (S3-compatible) behind cdn.tripkoach.com. Credentials come from the environment ONLY — the board's R2
# token file drops in verbatim (its own key names are read directly). When any of endpoint/bucket/key/
# secret is missing the media routes answer 503 (safe-when-unconfigured, like the email transport).
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # or S3_API from the token file
# R2_BUCKET=tripkoach
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_PUBLIC_URL=https://cdn.tripkoach.com                   # or CUSTOM_DOMAIN; falls back to cdn.tripkoach.com
# R2_REGION=auto
# MEDIA_KEY_PREFIX=media                 # object key prefix under the bucket (kept distinct from img/)
# MEDIA_MAX_BYTES=10485760               # 10MB upload cap
# MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
# MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable   # safe: keys are content-addressed by sha256
# MEDIA_TIMEOUT_MS=20000
