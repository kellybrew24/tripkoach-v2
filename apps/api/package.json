{
  "name": "@tripkoach/api",
  "version": "0.1.0",
  "private": true,
  "description": "TripKoach v2 API — clean-room Fastify + TypeScript service (TRI-857 / Phase 1: TRI-860). Serves the v2 SPAs from a fresh Postgres schema. No v1 assets.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "blog-import": "node --experimental-strip-types src/blog-import.ts",
    "admin-seed": "node --experimental-strip-types src/admin-seed.ts",
    "fx-refresh": "node --experimental-strip-types src/fx-refresh.ts",
    "send-email": "node --experimental-strip-types src/send-email.ts",
    "send-reminders": "node --experimental-strip-types src/send-reminders.ts",
    "smoke": "node --experimental-strip-types test/smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.11.0",
    "hash-wasm": "^4.11.0",
    "pg": "^8.13.0"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
