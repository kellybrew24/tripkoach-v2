      {
        "selector": "JSXOpeningElement[name.name='AuditEvent'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:created|confirmed|cancelled|paid|refunded|email|note|failed)$/]",
        "message": "<AuditEvent> type must be one of 'created' | 'confirmed' | 'cancelled' | 'paid' | 'refunded' | 'email' | 'note' | 'failed'."
