{
  "name": "tripkoach-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TripKoach v2 — customer web + staff admin apps, built from the tripv2 design system.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs web",
    "build:admin": "node scripts/build.mjs admin",
    "build:prod": "node scripts/build.mjs && node scripts/stamp-prod-config.mjs",
    "deploy:dev:web": "bash scripts/deploy-static.sh web dev",
    "deploy:dev:admin": "bash scripts/deploy-static.sh admin dev",
    "deploy:dev": "npm run deploy:dev:web && npm run deploy:dev:admin",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:reviews-live": "node scripts/smoke-live-reviews.mjs",
    "smoke:admin-live": "node scripts/smoke-admin-live.mjs",
    "verify": "npm run build && npm run smoke",
    "clean": "rm -rf apps/web/dist apps/admin/dist"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^30.0.1"
  }
}
